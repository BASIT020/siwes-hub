# =====================================================================
#  SIWES Hub - example environment file (development/demonstration)
#  config/settings.py reads these variables when they are set:
#
#    SIWES_SECRET_KEY              Django SECRET_KEY (production MUST set it;
#                                  development auto-generates one locally)
#    SIWES_ALLOWED_HOSTS           comma separated hostnames
#    SIWES_CSRF_TRUSTED_ORIGINS    comma separated full origins (scheme://host)
#    SIWES_DEBUG                   "0" for production disables DEBUG
#    SIWES_SECURE                  "1" for production enables HTTPS settings
#                                  (SSL redirect, secure cookies, HSTS)
#    SIWES_HOST / SIWES_PORT       bind address used by START_APP.bat
#
#  Copy to .env only for local experiments. NEVER commit a real .env and
#  never fill this file with a real secret. On PythonAnywhere these values
#  live in the web app's "Environment variables" section instead.
# =====================================================================

SIWES_SECRET_KEY=
SIWES_ALLOWED_HOSTS=127.0.0.1,localhost
SIWES_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SIWES_HOST=127.0.0.1
SIWES_PORT=8000
SIWES_DEBUG=1
SIWES_SECURE=0
